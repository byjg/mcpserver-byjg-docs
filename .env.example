# ---------------------------------------------------------------------------
# Copy to `.env` in this directory:   cp .env.example .env
#
# One file serves both ways of running:
#   docker compose  -- compose reads .env and passes these into the container
#   directly        -- the app reads .env itself on startup
# ---------------------------------------------------------------------------


# === REQUIRED for a deployment ==============================================
# Two DIFFERENT random values. Generate each with its own run of:
#     openssl rand -hex 32

# How clients authenticate: `bearer` (a token) or `none` (anyone that reaches
# the port). Compose defaults to `bearer`; set `none` only on a loopback bind,
# a trusted LAN, or behind an edge that authenticates (Cloudflare Access).
BYJG_DOCS_AUTH_TYPE=bearer

# Bearer token clients must send. Required by `bearer`, ignored by `none`.
# This is the only thing protecting the port.
BYJG_DOCS_AUTH_TOKEN=

# Must match the secret you configure on the GitHub webhook.
# Leave empty to disable the webhook endpoint entirely.
BYJG_DOCS_WEBHOOK_SECRET=

# NOT from openssl -- copy it from Cloudflare Zero Trust > Networks > Tunnels.
# Only needed if you run the tunnel as part of this stack:
#     docker compose --profile tunnel up -d
# Leave empty if you run cloudflared on the host, or do not use a tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# The hostname clients actually connect to -- the tunnel hostname if you use
# one, otherwise this machine's address. Must match what clients use, or their
# authentication fails.
BYJG_DOCS_PUBLIC_URL=https://mcp.example.com


# === Where the port is published on this host ===============================
# These two are read by docker compose only; they are not app settings.
#   0.0.0.0    all interfaces: other machines on your LAN connect by IP
#   127.0.0.1  this machine only
# The tunnel ignores this -- it reaches the container over the compose network.
BYJG_DOCS_BIND_ADDR=0.0.0.0
BYJG_DOCS_LOCAL_PORT=2954


# === Corpus =================================================================
# GitHub is the source of truth: each refresh clones this into a temporary
# directory, indexes it, and discards the checkout.
BYJG_DOCS_REPO_URL=https://github.com/byjg/byjg.github.io
BYJG_DOCS_GIT_BRANCH=master
BYJG_DOCS_SITE_URL=https://opensource.byjg.com

# Which folders of that repository to index, as JSON. Each one is a source:
#   name      prefixes its documents' source_path, keeping folders apart
#   subdir    folder in the repository ("" indexes the root)
#   route     path segment the site serves it under
#   category  forces the category, for a folder that is not category/project
# Defaults to the reference documentation plus the blog, which is this:
# BYJG_DOCS_SOURCES=[{"name":"docs","subdir":"docs","route":"docs"},{"name":"blog","subdir":"blog","route":"blog","category":"blog"}]

# Deprecated, and ignored when BYJG_DOCS_SOURCES is set: the pair that used to
# describe the one indexed folder. Setting either still pins that single folder.
# BYJG_DOCS_DOCS_SUBDIR=docs
# BYJG_DOCS_DOCS_ROUTE=docs

# Set ONLY for local development against an editable checkout: when set,
# nothing is cloned and this tree is indexed in place. Point it at the
# REPOSITORY ROOT, so every source finds its folder inside it. docker compose
# clears it, since a host path means nothing inside the container.
# BYJG_DOCS_DOCS_ROOT=


# === Running the server directly ============================================
# docker compose OVERRIDES these -- inside the container they describe paths
# and interfaces that only make sense there. They apply when you run the
# server yourself on the host.
BYJG_DOCS_TRANSPORT=stdio
BYJG_DOCS_HOST=127.0.0.1
BYJG_DOCS_PORT=2954
BYJG_DOCS_INDEX_PATH=./byjg-docs.db

# One JSON line per tool call (query, hit count, best score), to find what the
# docs do not cover. Empty = off. Compose writes to the `logs` volume.
BYJG_DOCS_QUERY_LOG=


# === Embeddings =============================================================
BYJG_DOCS_EMBEDDER_BACKEND=ollama
BYJG_DOCS_EMBEDDING_MODEL=nomic-embed-text
BYJG_DOCS_OLLAMA_URL=http://localhost:11434


# === Storage and retrieval ==================================================
BYJG_DOCS_STORE_BACKEND=sqlite
BYJG_DOCS_DEFAULT_LIMIT=8
BYJG_DOCS_MAX_LIMIT=25
